      id: "UCxAS_aK7sS2x_bqnlJHDSHw",
      name: "America\'s Test Kitchen",
      handle: Some("@AmericasTestKitchen"),
      avatar: [
        Thumbnail(
          url: "//yt3.googleusercontent.com/6pPZQkBWoQ-UAu5sT-Z47ID6vhPr-nnfziSpR84unn9vsDUzz5_iNS3WkuXSdKUKhkVGQerE=s88-c-k-c0x00ffffff-no-rj-mo",
