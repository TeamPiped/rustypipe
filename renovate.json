{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "semanticCommits": "enabled",
  "automerge": true,
  "automergeStrategy": "squash",
  "osvVulnerabilityAlerts": true,
  "labels": ["dependency-upgrade"],
  "enabledManagers": ["cargo"],
  "prHourlyLimit": 5
}
